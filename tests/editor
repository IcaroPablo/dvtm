#!/bin/sh
# A stand-in editor for the copy mode checks.
#
# dvtm-editor runs whatever $DVTM_EDITOR, $VISUAL or $EDITOR names, falling back
# to vi, and hands it the window's contents in a temporary file. Letting that
# fall through to the real editor made the checks depend on which one was
# installed and on what it prints, so this stands in for all of them.
#
# The file is the last argument, not the first: dvtm passes the editor a `+N` to
# open the scrollback at the right line, and dvtm-editor appends the temporary
# file after it.
#
# $EDITOR_MODE picks which of dvtm-editor's rules is being exercised:
#
#   show   print what arrived, then a marker, and hold the screen still. The
#          marker comes last on purpose -- a check that waits for it knows the
#          text is already on screen, with no sleep to tune.
#   edit   save something new and leave: dvtm must paste it
#   keep   leave without touching the file: dvtm must paste nothing
#   resave rewrite the file with the same content, which is what `:w` on an
#          unedited buffer does: dvtm must still paste nothing. Not the same
#          path as keep -- the file is written, so its modification time moves
#          and only the content says it is unchanged. The C original compared
#          st_mtime and would have pasted here.
#   big    save $EDITOR_BYTES of text, more than a pty will take in one go
#   fail   save something new and then fail: dvtm must still paste nothing,
#          which is the only case that tells the exit status apart from the
#          content check
#   multi  save three short lines: the shape of the report, since a one-line
#          paste is exactly the case that always worked
#   stay   two runs, counted in $EDITOR_SEQ: the first saves PASTEME and
#          leaves, the second saves SECONDTEXT and never exits. That is an
#          editor sitting on a saved buffer -- `:w` without `:q` -- and it is
#          the one shape in which dvtm cannot have been handed anything, since
#          dvtm-editor only writes once the editor is gone. Each run leaves
#          $EDITOR_WITNESS.$n behind, so a check can wait for the run it means.
#
# $EDITOR_WITNESS, when set, is created before exiting, so a check can tell
# "the editor ran and decided nothing" from "the editor never ran".
for f in "$@"; do :; done

[ -n "$EDITOR_WITNESS" ] && : > "$EDITOR_WITNESS"

case ${EDITOR_MODE:-show} in
edit) printf 'PASTEME\n' > "$f" ;;
keep) ;;
resave) cp "$f" "$f.same" && mv "$f.same" "$f"
     [ -n "$EDITOR_WITNESS" ] && : > "$EDITOR_WITNESS.done" ;;
big) awk -v n="${EDITOR_BYTES:-65536}" 'BEGIN {
         s = ""; while (length(s) < 63) s = s "x"
         for (i = 0; i * 64 < n; i++) print s
         print "BIGEND" }' > "$f"
     # The witness above only says this ran. A check that needs the writing
     # to be over waits for this one instead.
     [ -n "$EDITOR_WITNESS" ] && : > "$EDITOR_WITNESS.done" ;;
fail) printf 'PASTEME\n' > "$f"; exit 3 ;;
multi) printf 'L1\nL2\nL3\n' > "$f" ;;
stay) n=0
      [ -f "$EDITOR_SEQ" ] && n=$(cat "$EDITOR_SEQ")
      n=$((n + 1))
      printf '%s\n' "$n" > "$EDITOR_SEQ"
      if [ "$n" -eq 1 ]; then
          printf 'PASTEME\n' > "$f"
      else
          printf 'SECONDTEXT\n' > "$f"
      fi
      [ -n "$EDITOR_WITNESS" ] && : > "$EDITOR_WITNESS.$n"
      # `if`, not `&&`: a false test as the last command would leave a non-zero
      # status behind, and dvtm-editor reads that as an editor that failed.
      if [ "$n" -gt 1 ]; then sleep 60; fi ;;
*)    grep -v '^[ 	]*$' "$f"
      printf 'EDITORSTARTED\n'
      sleep 30 ;;
esac
